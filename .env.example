# ─── Copy this file to .env.local for local development ─────────────────────
# On Vercel: add these in Project Settings → Environment Variables

# Your live domain — used for sitemap, canonical URLs, and OG images
# No trailing slash
SITE_URL=https://fitlabreviews.com

# Plausible analytics — uncomment when you create your Plausible account
# Set this ONLY in Production environment on Vercel (not Preview/Development)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=fitlabreviews.com

# Optional: Algolia search if you add it later
# NEXT_PUBLIC_ALGOLIA_APP_ID=
# NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=
